tv_code <- mread("clesrovimab_TVsim.cpp")
tv_nomatfcn <- mread("clesrovimab_TVsimnomatfcn.cpp")
ADJAGETV <- c(12, 24, 36, 48, 60, 72)
WT <- c(10, 13, 14, 16, 18, 21)
ID <- 1:6
data <- data.frame(ADJAGETV=ADJAGETV, WT=WT, ID=ID)
dose <- ev(amt=105, cmt="DEPOT", evid=1)
tv_sim <- tv_code %>%
idata_set(data) %>%
carry_out(WT, ADJAGETV, CL) %>%
mrgsim(events=dose, end=151, delta=1) %>%
as_data_frame()
tv_sim <- tv_sim %>%
mutate(
WT=paste0(WT, " kg")
)
cp_150 <- tv_sim %>%
filter(time==150)
sim_plot <- ggplot(tv_sim, aes(x=time, y=DV, color=factor(ADJAGETV))) +
geom_line(linewidth=0.6) +
geom_point(data= cp_150,
aes(x=time, y=DV),
color="black",
size=2) +
geom_text(data=cp_150,
aes(x=time, y=DV, label=round(DV, 2)),
vjust=-1,
size=3,
check_overlap=TRUE) +
labs(title="Simulated Concentration vs Time Profile in 1-6 year old",
x="Time (day)",
y="Concentration (ug/mL)",
caption="Pop PK model with maturation function",
color="Age of Child (month)")
tv_sim_nomatfcn <- tv_nomatfcn %>%
idata_set(data) %>%
carry_out(WT, ADJAGETV, CL) %>%
mrgsim(events=dose, end=151, delta=1) %>%
as_data_frame()
tv_sim_nomatfcn <- tv_sim_nomatfcn %>%
mutate(
WT=paste0(WT, " kg")
)
cp_150_nomatfcn <- tv_sim_nomatfcn %>%
filter(time==150)
sim_plot2 <- ggplot(tv_sim_nomatfcn, aes(x=time, y=DV, color=factor(ADJAGETV))) +
geom_line(linewidth=0.6) +
geom_point(data= cp_150_nomatfcn,
aes(x=time, y=DV),
color="black",
size=2) +
geom_text(data=cp_150_nomatfcn,
aes(x=time, y=DV, label=round(DV, 2)),
vjust=-1,
size=3,
check_overlap=TRUE) +
labs(title="Simulated Concentration vs Time Profile in 1-6 year old",
x="Time (day)",
y="Concentration (ug/mL)",
