# mean clearance value from 100mg/300mg IM arms of the Aliprantis et al (2020) study
CLadult <- 0.085
AGE <- c(1,2,3,4,5,6,40)
# the average 5th, median, and 95th percentile of WHO (<2yr) and CDC(>=2yr)
# weight for each age in year for both boys and girls
WT1 <- seq(7.75, 11.15, by=0.01) # weight distribution for 1 year old
WT2 <- seq(10.55, 15, by=0.01) # weight distribution for 2 year old
WT3 <- seq(12.35, 18.05, by=0.01) # weight distribution for 3 year old
WT4 <- seq(13.95, 21, by=0.01) # weight distribution for 4 year old
WT5 <- seq(15.5, 24.35, by=0.01) # weight distribution for 5 year old
WT6 <- seq(17.15, 28.3, by=0.01)  # weight distribution for 6 year old
# This function comes from Mahmood et al. (2020)
CLpred <- function(b, WTinput, CLadult) {
CLvec <- CLadult*(WTinput/70)^b
CLmean <- mean(CLvec, na.rm=TRUE)
CLmean
}
CL1 <- CLpred(1, WT1, CLadult)
CL2 <- CLpred(0.9, WT2, CLadult)
CL3 <- CLpred(0.9, WT3, CLadult)
CL4 <- CLpred(0.9, WT4, CLadult)
CL5 <- CLpred(0.75, WT5, CLadult)
CL6 <- CLpred(0.75, WT6, CLadult)
CLpop <- c(CL1, CL2, CL3, CL4, CL5, CL6, CLadult)
CLplot <- data.frame(CLpop, AGE)
ggplot(CLplot, aes(AGE, CLpop)) +
geom_point()
ggplot(CLplot, aes(AGE, CLpop)) +
geom_point() +
labs(
x= "AGE(years)",
y= "Clearance (L/d)"
)
