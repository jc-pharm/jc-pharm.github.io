y="Concentration (ug/mL)",
color="Age of Child (month)",
caption="Solid line (median concentrations) with shaded region (+/- 2 SD)")
fullsimplot
source("~/.active-rstudio-document", echo = TRUE)
set.seed(2345)
simpop <- data.frame(
ADJAGETV = c(
rep(12, length(WT1)),
rep(24, length(WT2)),
rep(36, length(WT3)),
rep(48, length(WT4)),
rep(60, length(WT5)),
rep(72, length(WT6))
),
WT = c(WT1, WT2, WT3, WT4, WT5, WT6)
) %>%
mutate(
ID = row_number(),
time=0,
evid=0,
amt=0,
cmt="DEPOT",
)
fullsimdose <- simpop %>%
mutate(
time=0,
amt=105,
cmt="DEPOT",
evid=1
)
fullsimdata <- bind_rows(simpop, fullsimdose) %>%
arrange(ID, time)
fullsim <- code %>%
idata_set(fullsimdata) %>%
carry_out(WT, ADJAGETV, CL) %>%
mrgsim(events=fullsimdose, end=151, delta=1) %>%
as.data.frame()
fullsim <- fullsim %>%
mutate(
WT=paste0(WT, " kg")
)
summary_fullsim <- fullsim %>%
group_by(ADJAGETV, time) %>%
summarize(
median_conc = median(DV, na.rm=TRUE),
sd_conc = sd(DV, na.rm=TRUE),
.groups="drop"
) %>%
mutate(
lower_bound = median_conc - 2*sd_conc,
upper_bound = median_conc + 2*sd_conc
)
fullcp_150 <- summary_fullsim %>%
filter(time==150)
text_data <- fullcp_150 %>%
group_by(ADJAGETV) %>%
slice_tail(n = 1)
fullsimplot <- ggplot(summary_fullsim, aes(x=time, y=median_conc, color=factor(ADJAGETV))) +
geom_line(linewidth=0.6) +
geom_errorbar(
aes(ymin=lower_bound, ymax=upper_bound),
width = 2,
alpha=0.5
) +
geom_point(data= fullcp_150,
aes(x=time, y=median_conc),
color="black",
size=2) +
geom_text(
data = text_data,
aes(x = time, y = upper_bound, label = round(upper_bound, 1)),
hjust = -0.5, # Pushes text to the right of the point/error bar
vjust = -0.9,
size = 4,
fontface = "italic",
show.legend = FALSE
) +
# Median Text
geom_text(
data = text_data,
aes(x = time, y = median_conc, label = round(median_conc, 1)),
hjust = -0.5,
vjust = -0.3,
size = 4,
fontface = "italic",
show.legend = FALSE
) +
# Lower Bound Text
geom_text(
data = text_data,
aes(x = time, y = lower_bound, label = round(lower_bound, 1)),
hjust = -0.5,
vjust = 0.3,
size = 4,
fontface = "italic",
show.legend = FALSE
) +
scale_x_continuous(expand = expansion(mult = c(0.1, 0.4))) +
facet_wrap(~ADJAGETV) +
labs(title="Simulated Concentration vs Time Profile in 1-6 years old",
x="Time (day)",
y="Concentration (ug/mL)",
color="Age of Child (month)",
caption="Solid line (median concentrations) with shaded region (+/- 2 SD)")
fullsimplot
set.seed(1234)
code <- mread("clesrovimab_fullsim.cpp")
subpop <- data.frame(
ADJAGETV = 1:6,
WT = c(5, 6, 6, 7, 7, 8)
)
n_per_age <- 500
subjects <- subpop %>%
group_by(ADJAGETV) %>%
reframe(
ID = ((ADJAGETV -1) * n_per_age + 1): (ADJAGETV*n_per_age),
WT=WT
)
pop <- expand.grid(
ID = subjects$ID,
time=seq(0,150,by=1),
amt=0,
cmt="DEPOT",
evid=0
)
f_dose <- subjects %>%
mutate(
time=0,
amt=105,
cmt="DEPOT",
evid=1
)
fdata <- bind_rows(pop, f_dose) %>%
arrange(ID, time)
f_sim <- code %>%
idata_set(fdata) %>%
carry_out(WT, ADJAGETV, CL) %>%
mrgsim(events=f_dose, end=151, delta=1) %>%
as.data.frame()
f_sim <- f_sim %>%
mutate(
WT=paste0(WT, " kg")
)
summary_f_sim <- f_sim %>%
group_by(ADJAGETV, time) %>%
summarize(
median_conc = median(DV, na.rm=TRUE),
sd_conc = sd(DV, na.rm=TRUE),
.groups="drop"
) %>%
mutate(
lower_bound = median_conc - 2*sd_conc,
upper_bound = median_conc + 2*sd_conc
)
fcp_150 <- summary_f_sim %>%
filter(time==150)
f_plot <- ggplot(summary_f_sim, aes(x=time, y=median_conc, color=factor(ADJAGETV))) +
geom_line(linewidth=0.6) +
geom_errorbar(
aes(ymin=lower_bound, ymax=upper_bound),
width = 2,
alpha=0.5
) +
geom_point(data= fcp_150,
aes(x=time, y=median_conc),
color="black",
size=2) +
geom_text(data=fcp_150,
aes(x=time, y=median_conc, label=round(median_conc, 2)),
vjust=-1,
size=3,
check_overlap=TRUE) +
facet_wrap(~ADJAGETV) +
labs(title="Simulated Concentration vs Time Profile in 1-6 months old",
x="Time (day)",
y="Concentration (ug/mL)",
color="Age of Child (month)",
caption="Solid line (median concentrations) with shaded region (+/- 2 SD)")
f_plot
inf_plot <- ggplot(inf_sim, aes(x=time, y=DV, color=factor(ADJAGETV))) +
